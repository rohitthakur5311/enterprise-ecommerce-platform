APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

AUTH_DATABASE_URL=sqlite+aiosqlite:///./auth.db
CATALOG_DATABASE_URL=sqlite+aiosqlite:///./catalog.db
ORDERS_DATABASE_URL=sqlite+aiosqlite:///./orders.db

REDIS_URL=redis://localhost:6379/0
AUTH_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
ORDERS_SERVICE_URL=http://localhost:8003

CORS_ORIGINS=http://localhost:8000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=100
LOG_LEVEL=INFO
